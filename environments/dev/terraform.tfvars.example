location            = "southafricanorth"
resource_group_name = "rg-cms-dev"
name_prefix         = "cms"

postgres_version               = "16"
postgres_sku_name              = "B_Standard_B1ms"
postgres_storage_mb            = 32768
postgres_backup_retention_days = 7
postgres_admin_login           = "cmsadmin"
postgres_database_name         = "cms"
# Set this to the existing password when migrating an existing server, or use
# TF_VAR_postgres_admin_password. Null generates a new password.
# postgres_admin_password = "..."

allowed_client_ips = ["203.0.113.10"]
# Container App egress has no static IP, so the CMS needs the Azure services rule.
postgres_allow_azure_services = true

acr_sku_name      = "Basic"
acr_admin_enabled = true

# Headless CMS
cms_image_tag = "latest"
cms_paused    = false
# Public frontend URL for admin preview origins and password-reset links.
# cms_client_url = "https://www.example.com"
# Prefer TF_VAR_strapi_stripe_secret_key over checking a key into tfvars.
# strapi_stripe_secret_key = "sk_test_..."

# Landing page. PREVIEW_SECRET is generated by the CMS module and wired
# automatically; do not set it here.
landing_image_tag = "latest"
