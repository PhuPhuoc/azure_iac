# Terraform provider binaries and modules
.terraform/

# State and plan files (contain secrets and may contain full resource data)
*.tfstate
*.tfstate.*
*.tfplan
tfplan

# Crash logs
crash.log
crash.*.log

# Variable files (secrets); keep the documented example
*.tfvars
*.tfvars.json

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI config (can contain credentials / plugin cache settings)
.terraformrc
terraform.rc

# Database dumps (live CMS data, personal records; never commit)
*.dump
*.sql
*.sql.gz

# Reviewed bootstrap SQL is configuration, not data.
!environments/*/bootstrap/*.sql
